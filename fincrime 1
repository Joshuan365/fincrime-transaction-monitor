   "source": [
    "# Add velocity check: same account multiple transactions in short time\n",
    "df['velocity_flag'] = df.groupby('account_age_days')['amount'].transform('count') > 1\n",
    "\n",
    "# Add structuring check: amounts just under £10k to avoid detection\n",
    "structuring = df[(df['amount'] > 9000) & (df['amount'] < 10000)]\n",
    "\n",
    "# Update SAR report to include new rules\n",
    "sar_report = pd.concat([high_value, suspicious_country, new_account_large, structuring]).drop_duplicates()\n",
    "sar_report.to_csv('sar_report.csv', index=False)\n",
    "print(f\"Flagged {len(sar_report)} transactions with 4 AML rules\")"
   ]
  },

   "id": "062318ac-df75-47df-9f57-859a6a8276d5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "High value transactions:\n",
      "   transaction_id  amount country  account_age_days\n",
      "1               2   12000      NG                45\n",
      "3               4   25000      UK                15\n",
      "5               6   45000      UK              2000\n",
      "8               9   11000      RU                20\n",
      "\n",
      "High-risk country transactions:\n",
      "   transaction_id  amount country  account_age_days\n",
      "1               2   12000      NG                45\n",
      "2               3     800      RU               300\n",
      "4               5     300      IR                60\n",
      "6               7     900      NG                30\n",
      "8               9   11000      RU                20\n",
      "\n",
      "New account + large amount:\n",
      "   transaction_id  amount country  account_age_days\n",
      "1               2   12000      NG                45\n",
      "3               4   25000      UK                15\n",
      "8               9   11000      RU                20\n"
     ]
    }
   ],
   "source": [
    "# Rule 1: Flag high value > £10k\n",
    "high_value = df[df['amount'] > 10000]\n",
    "print(\"High value transactions:\")\n",
    "print(high_value)\n",
    "\n",
    "# Rule 2: Flag high-risk countries\n",
    "high_risk = ['NG', 'RU', 'IR']\n",
    "suspicious_country = df[df['country'].isin(high_risk)]\n",
    "print(\"\\nHigh-risk country transactions:\")\n",
    "print(suspicious_country)\n",
    "\n",
    "# Rule 3: Flag new accounts with large transfers\n",
    "new_account_large = df[(df['account_age_days'] < 90) & (df['amount'] > 5000)]\n",
    "print(\"\\nNew account + large amount:\")\n",
    "print(new_account_large)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "04249bb6-0e6f-4efe-8716-487e08d248ad",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Flagged 7 transactions for review\n"
     ]
    }
   ],
   "source": [
    "# Combine all flags into one SAR report\n",
    "sar_report = pd.concat([high_value, suspicious_country, new_account_large]).drop_duplicates()\n",
    "sar_report.to_csv('sar_report.csv', index=False)\n",
    "print(f\"Flagged {len(sar_report)} transactions for review\")"
   ]
  },

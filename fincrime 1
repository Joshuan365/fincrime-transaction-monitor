   "source": [
    "import pandas as pd\n",
    "\n",
    "# Sample transaction data\n",
    "data = {\n",
    "    'transaction_id': range(1, 11),\n",
    "    'amount': [150, 12000, 800, 25000, 300, 45000, 900, 200, 11000, 600],\n",
    "    'country': ['UK', 'NG', 'RU', 'UK', 'IR', 'UK', 'NG', 'UK', 'RU', 'UK'],\n",
    "    'account_age_days': [1200, 45, 300, 15, 60, 2000, 30, 900, 20, 1500]\n",
    "}\n",
    "\n",
    "df = pd.DataFrame(data)\n",
    "df.head()  # Run this to see the table"
   ]
  },
  {
   "cell_type": "code",
